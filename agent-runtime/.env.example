PORT=8101
HOST=0.0.0.0

# LLM (OpenCode OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
DEEPSEEK_ZEN_BASE_URL=https://opencode.ai/zen/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_FALLBACK_MODELS=gpt-5,gemini-3.6-flash,kimi-k3,claude-sonnet-5

# LLM / Deep Research synthesis
LLM_TIMEOUT_MS=90000
DR_SYNTHESIS_TIMEOUT_MS=180000
DR_SYNTHESIS_MAX_TOKENS=4096
DR_SYNTHESIS_MAX_MODELS=2

# Conversations DB (shared with Python backend)
CONVERSATIONS_DATA_DIR=../agent-backend/runtime/conversations

# MCP
QPTM_MCP_COMMAND=python3
QPTM_MCP_ARGS=-m,mcp_server
QPTM_MCP_CWD=../agent-backend
BIOMCP_COMMAND=biomcp
BIOMCP_ARGS=serve

# Web search (optional — Tavily)
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_MS=5000

# Skills
SKILLS_DIR=../skills
